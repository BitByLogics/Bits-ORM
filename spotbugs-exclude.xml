<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- Constructors fail fast (null checks, unusable database file, invalid table names). This is an
         in-process library with no security manager or untrusted subclasses, so the finalizer-attack
         scenario this pattern guards against does not apply. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- The flagged fields and parameters are service handles (BormAPI, BormTable, DataSource, Logger,
         reflection Fields) or internal ORM metadata that is wired together after construction, not
         mutable value data. Copying them defensively would break the shared-instance design. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
